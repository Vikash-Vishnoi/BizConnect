# WhatsApp Marketing Platform - Environment Variables

# ============================================
# API Configuration
# ============================================
# Backend API base URL
# Development: http://localhost:3000/api
# Production: https://your-domain.com/api
REACT_APP_API_URL=http://localhost:3000/api

# WebSocket URL for real-time features
# Development: http://localhost:3000
# Production: https://your-domain.com
REACT_APP_WS_URL=http://localhost:3000

# ============================================
# Application Configuration
# ============================================
# Application name (displayed in UI)
REACT_APP_NAME=WhatsApp Marketing Platform

# ============================================
# Optional Configuration
# ============================================
# Uncomment and configure as needed:

# Google Analytics ID
# REACT_APP_GA_ID=UA-XXXXXXXXX-X

# Sentry DSN for error tracking
# REACT_APP_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Enable debug mode
# REACT_APP_DEBUG=false

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. DO NOT commit this file with sensitive production values
# 2. Add .env to .gitignore
# 3. Use .env.local for local overrides (also in .gitignore)
# 4. Use .env.production for production builds
# 5. Restart dev server after changing these values
# 6. Environment variables must start with REACT_APP_ to be accessible

# ============================================
# DEPLOYMENT
# ============================================
# For production deployment:
# 1. Copy this file to .env.production
# 2. Update REACT_APP_API_URL to production URL
# 3. Update REACT_APP_WS_URL to production URL
# 4. Set environment variables in your hosting platform
#    (Vercel, Netlify, AWS, etc.)
# 5. Never commit .env files with real credentials

# ============================================
# ADDITIONAL OPTIONAL FEATURES
# ============================================
# Feature flags for enabling/disabling features
# REACT_APP_ENABLE_ANALYTICS=true
# REACT_APP_ENABLE_ERROR_TRACKING=true
# REACT_APP_ENABLE_DEBUG_MODE=false

# API timeout in milliseconds
# REACT_APP_API_TIMEOUT=30000

# Maximum file upload size (in bytes)
# REACT_APP_MAX_FILE_SIZE=10485760

# WebSocket reconnection attempts
# REACT_APP_WS_RECONNECT_ATTEMPTS=5
