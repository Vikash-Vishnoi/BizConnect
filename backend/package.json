{
  "name": "whatsapp-marketing-backend",
  "version": "1.0.0",
  "description": "Backend server for WhatsApp Marketing App with MongoDB and WhatsApp Business API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:debug": "nodemon --inspect src/server.js",
    "test": "jest --coverage --maxWorkers=50%",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit --maxWorkers=50%",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:ci": "jest --coverage --ci --maxWorkers=2",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "validate": "npm run lint && npm run format:check && npm test",
    "validate:quick": "npm run lint && npm run format:check",
    "prepare": "node -e \"try { require('husky').install() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
    "precommit": "npm run lint:fix && npm run format",
    "seed": "node seed-database.js",
    "docs:generate": "node scripts/generateDocumentation.js",
    "db:indexes": "node scripts/createAllIndexes.js",
    "db:analyze": "node scripts/indexAnalysis.js"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-business-api",
    "mongodb",
    "express",
    "socket.io",
    "multi-tenant",
    "messaging",
    "campaigns"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.0",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "pdfkit": "^0.17.2",
    "socket.io": "^4.6.0",
    "uuid": "^13.0.0",
    "validator": "^13.11.0",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  }
}
