# ===================================
# WhatsApp Business API Configuration
# ===================================
# Authentication & JWT Configuration
# ===================================
JWT_SECRET=your-super-secret-jwt-key-here-change-this
JWT_REFRESH_SECRET=your-refresh-token-secret-here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_EXPIRE_DAYS=7

# ===================================
# MongoDB Configuration
# ===================================
MONGODB_URI=mongodb://localhost:27017/whatsapp-business
MONGODB_URI_TEST=mongodb://localhost:27017/whatsapp-business-test

# ===================================
# Redis Configuration (Optional)
# ===================================
REDIS_URL=redis://localhost:6379
# OR specify individually:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ===================================
# Server Configuration
# ===================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ===================================
# Timeout Configuration (milliseconds)
# ===================================
HANDLER_TIMEOUT=30000
WEBHOOK_TIMEOUT=30000

# ===================================
# Validation Limits
# ===================================
MAX_MESSAGE_LENGTH=4096
MAX_TEMPLATE_NAME_LENGTH=512
MAX_CAMPAIGN_RECIPIENTS=10000
MAX_BULK_CONTACTS=1000
MAX_BULK_OPERATIONS=100
MAX_TAGS_PER_OPERATION=10
MIN_PASSWORD_LENGTH=6
MAX_NAME_LENGTH=100
MAX_DESCRIPTION_LENGTH=1000
MAX_SEND_RATE=80
MAX_CAPTION_LENGTH=1024
MAX_URL_LENGTH=2048

# ===================================
# Security Configuration
# ===================================
MESSAGING_LIMIT_WARNING_THRESHOLD=0.8
BCRYPT_ROUNDS=10

# ===================================
# Logging Configuration
# ===================================
LOG_LEVEL=info
LOG_HEADERS=false
LOG_REQUEST_BODY=false
LOG_FILE_PATH=./logs
LOG_MAX_FILE_SIZE=10485760
LOG_MAX_FILES=10
ENABLE_CONSOLE_LOGGING=false

# ===================================
# Rate Limiting Windows (milliseconds)
# ===================================
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_WINDOW=900000
RATE_LIMIT_API_MAX=100
RATE_LIMIT_WEBHOOK_WINDOW=60000
RATE_LIMIT_WEBHOOK_MAX=500

# ===================================
# WhatsApp API Configuration
# ===================================
WHATSAPP_API_VERSION=v22.0
WHATSAPP_API_URL=https://graph.facebook.com

# ===================================
# API Configuration
# ===================================
API_MAX_RETRIES=3
API_RETRY_DELAY=1000
GRAPH_API_TIMEOUT=30000

# ===================================
# File Upload Configuration
# ===================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ===================================
# Cache Configuration
# ===================================
BUSINESS_CACHE_TTL=300000

# ===================================
# Job Scheduler Configuration
# ===================================
ENABLE_CRON_JOBS=true
QUALITY_CHECK_INTERVAL=0 */6 * * *
TEMPLATE_SYNC_INTERVAL=*/15 * * * *
LOG_CLEANUP_INTERVAL=0 2 * * *
ANALYTICS_ARCHIVE_INTERVAL=0 3 * * *
AUDIT_LOG_RETENTION_DAYS=90
ALERT_LOG_RETENTION_DAYS=30
MESSAGE_ERROR_RETENTION_DAYS=60
ANALYTICS_HOT_DATA_DAYS=90
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_CACHE_RETENTION_DAYS=7
MIGRATION_BATCH_SIZE=100
QUALITY_CHECK_DELAY=5000
TEMPLATE_SYNC_TIMEOUT=10000
TEMPLATE_SYNC_DELAY=2000
TEMPLATE_SYNC_STARTUP_DELAY=5000

# ===================================
# Email Configuration (for notifications)
# ===================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# ===================================
# External Services
# ===================================
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===================================
# Welcome Message Configuration
# ===================================
WELCOME_MESSAGE_ENABLED=true
WELCOME_MESSAGE_STRATEGY=template
WELCOME_TEMPLATE_PATTERN=welcome|greeting|hello|hi
WELCOME_TEMPLATE_NAME=welcome_message
WELCOME_TEMPLATE_LANGUAGE=en
WELCOME_TEMPLATE_CATEGORY=UTILITY
WELCOME_MESSAGE_TEXT=Hello! 👋 Thank you for contacting us. We've received your message and will respond shortly.
WELCOME_MESSAGE_USE_RANDOM=false
WELCOME_MESSAGE_DELAY=2000
WELCOME_BUSINESS_HOURS_ENABLED=false
WELCOME_OUTSIDE_HOURS_MESSAGE=Hello! 👋 Thank you for contacting us. We're currently outside business hours but will respond when we're back.
WELCOME_MESSAGE_LOGGING=true

# ===================================
# Alert System Configuration
# ===================================
ALERTS_DEFAULT_LIMIT=50
ALERTS_MAX_LIMIT=100

# ===================================
# WhatsApp Tier Limits Configuration
# ===================================
WHATSAPP_TIER_NOT_SET=50
WHATSAPP_TIER_50=250
WHATSAPP_TIER_250=1000
WHATSAPP_TIER_1K=10000
WHATSAPP_TIER_10K=100000
WHATSAPP_TIER_100K=1000000

# ===================================
# Spending Analytics Configuration
# ===================================
WHATSAPP_COST_PER_MESSAGE=0.005
SPENDING_MONTHLY_PROJECTION_DAYS=30
SPENDING_CRITICAL_THRESHOLD=90
SPENDING_WARNING_THRESHOLD=75
SPENDING_HISTORY_DEFAULT_DAYS=30
SPENDING_HISTORY_MAX_DAYS=90

# ===================================
# Audit Logs Configuration
# ===================================
AUDIT_LOGS_DEFAULT_LIMIT=50
AUDIT_LOGS_MAX_LIMIT=1000
AUDIT_LOGS_DEFAULT_STATS_DAYS=30
AUDIT_LOGS_DEFAULT_TIMELINE_DAYS=30
AUDIT_LOGS_DEFAULT_SENSITIVE_DAYS=7
AUDIT_LOGS_EXPORT_LIMIT=10000

# ===================================
# Automation Configuration
# ===================================
AUTOMATION_LOGS_DEFAULT_LIMIT=50
AUTOMATION_LOGS_MAX_LIMIT=500

# ===================================
# Business Verification Configuration
# ===================================
VERIFICATION_MIN_MESSAGES=10
VERIFICATION_VIOLATION_LOOKBACK_DAYS=7

# ===================================
# Campaign Configuration
# ===================================
CAMPAIGNS_DEFAULT_LIMIT=20
CAMPAIGNS_MAX_LIMIT=100
CAMPAIGN_RECIPIENTS_DEFAULT_LIMIT=100
CAMPAIGN_DEFAULT_BATCH_SIZE=1000
CAMPAIGN_DEFAULT_DELAY_MS=60000

# ===================================
# Contact Management Configuration
# ===================================
CONTACT_DUPLICATE_THRESHOLD=80
CONTACT_DUPLICATES_LIMIT=50
CONTACT_HISTORY_DEFAULT_LIMIT=50
CONTACT_RECENT_CHANGES_LIMIT=20
CONTACT_RECENT_CHANGES_HOURS=24

# ===================================
# Flow Configuration
# ===================================
FLOW_RESPONSES_DEFAULT_LIMIT=50
FLOW_RESPONSES_MAX_LIMIT=200
FLOWS_DEFAULT_LIMIT=50
FLOWS_MAX_LIMIT=200

# ===================================
# GDPR Configuration
# ===================================
GDPR_REQUESTS_DEFAULT_LIMIT=50
GDPR_REQUESTS_MAX_LIMIT=200

# ===================================
# Conversation & Messaging Configuration
# ===================================
CONVERSATIONS_DEFAULT_LIMIT=20
CONVERSATIONS_MAX_LIMIT=100
MESSAGES_DEFAULT_LIMIT=50
MESSAGES_MAX_LIMIT=200
CONVERSATION_WINDOW_HOURS=24

# ===================================
# Media Upload Configuration
# ===================================
MEDIA_MAX_FILE_SIZE_MB=16

# ===================================
# Message Echoes Configuration
# ===================================
MESSAGE_ECHOES_DEFAULT_LIMIT=50
MESSAGE_ECHOES_MAX_LIMIT=200
MESSAGE_ECHOES_UNPROCESSED_LIMIT=100

# ===================================
# Message Errors Configuration
# ===================================
MESSAGE_ERRORS_DEFAULT_LIMIT=50
MESSAGE_ERRORS_MAX_LIMIT=200

# ===================================
# Opt-In Management Configuration
# ===================================
OPT_IN_DEFAULT_LIMIT=50
OPT_IN_MAX_LIMIT=200

# ===================================
# Phone Health Monitoring Configuration
# ===================================
PHONE_HEALTH_HISTORY_LIMIT=30
PHONE_HEALTH_HISTORY_MAX_LIMIT=90
WHATSAPP_TIER_1_LIMIT=1000
WHATSAPP_TIER_2_LIMIT=10000
WHATSAPP_TIER_3_LIMIT=100000

# ===================================
# Profile & User Settings Configuration
# ===================================
PROFILE_PHOTO_MAX_SIZE_MB=5

# ===================================
# Rate Limits Tracking Configuration
# ===================================
RATE_LIMITS_DEFAULT_LIMIT=50
RATE_LIMITS_ADMIN_LIMIT=500

# ===================================
# Scheduled Messages Configuration
# ===================================
SCHEDULED_MESSAGES_DEFAULT_LIMIT=20
SCHEDULED_MESSAGES_MAX_LIMIT=100

# ===================================
# Search Configuration
# ===================================
SEARCH_MESSAGES_DEFAULT_LIMIT=50
SEARCH_MESSAGES_MAX_LIMIT=200
SEARCH_CONVERSATIONS_DEFAULT_LIMIT=50
SEARCH_CONVERSATIONS_MAX_LIMIT=100
SEARCH_COMBINED_DEFAULT_LIMIT=20
SEARCH_COMBINED_MAX_LIMIT=50

# ===================================
# Quality Rating Configuration
# ===================================
QUALITY_RATING_HISTORY_LIMIT=30
QUALITY_RATING_HISTORY_MAX_LIMIT=90

# ===================================
# Tags Configuration
# ===================================
TAG_NAME_MAX_LENGTH=50
TAG_NAME_PATTERN=^[a-zA-Z0-9_-]{1,50}$
TAG_SUGGESTIONS_LIMIT=10

# ===================================
# Templates Configuration
# ===================================
TEMPLATES_DEFAULT_LIMIT=20
TEMPLATES_MAX_LIMIT=100
TEMPLATES_MAX_DRAFTS=10
TEMPLATES_TOP_LIMIT=5
TEMPLATE_ANALYTICS_DEFAULT_LIMIT=20
TEMPLATE_ANALYTICS_MAX_LIMIT=100
TEMPLATE_TOP_PERFORMERS_LIMIT=10
TEMPLATE_TOP_PERFORMERS_MAX_LIMIT=50
TEMPLATE_MIN_COMPLIANCE_SCORE=70

# ===================================
# Tracking Events Configuration
# ===================================
TRACKING_EVENTS_DEFAULT_LIMIT=100
TRACKING_EVENTS_MAX_LIMIT=500
TRACKING_EVENTS_CONTACT_LIMIT=100
TRACKING_EVENTS_DEFAULT_DAYS=30

# ===================================
# Webhook Configuration
# ===================================
ALERT_DEDUPLICATION_MINUTES=5

# ===================================
# User Preferences Configuration
# ===================================
USER_PREFERENCES_DEFAULT_LIMIT=100
USER_PREFERENCES_MAX_LIMIT=500
